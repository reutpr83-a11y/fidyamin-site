[{"start": 0.133, "end": 1.673, "lines": ["אז פוליטי אמרתם?"], "emp": false}, {"start": 1.713, "end": 3.773, "lines": ["ביקורת על מיליונים", "היא פוליטית?"], "emp": true}, {"start": 3.813, "end": 5.417, "lines": ["תגידו, אתם", "השתגעתם?"], "emp": true}, {"start": 5.457, "end": 8.837, "lines": ["ב 15 לאוקטובר יש לנו", "דיון בבית המשפט בעתירה"], "emp": false}, {"start": 8.877, "end": 9.717, "lines": ["שהגשנו."], "emp": false}, {"start": 9.757, "end": 12.857, "lines": ["המטרה שלנו היא לעצור מיד", "את העברת הכספים הזאת,"], "emp": false}, {"start": 12.897, "end": 14.717, "lines": ["עד שנבין בדיוק מה קורה", "פה."], "emp": false}, {"start": 14.757, "end": 18.257, "lines": ["העירייה מקצצת מיליונים", "מאנשי המקצוע שעובדים"], "emp": false}, {"start": 18.297, "end": 18.797, "lines": ["אצלה,"], "emp": false}, {"start": 18.817, "end": 22.097, "lines": ["ושופכת את הכסף הזה על", "קבלנים חיצוניים."], "emp": false}, {"start": 22.137, "end": 24.907, "lines": ["פשוט מיליונים, שמי יודע", "לאן הם הולכים."], "emp": false}, {"start": 24.947, "end": 26.747, "lines": ["רק כמה דוגמאות קטנות."], "emp": false}, {"start": 27.073, "end": 30.833, "lines": ["בהנדסה מקצצים עכשיו 1.3", "מיליון שקלים משכר עובדי"], "emp": false}, {"start": 30.873, "end": 33.433, "lines": ["העירייה מול תוספת של", "כמעט מיליון שקלים"], "emp": false}, {"start": 33.473, "end": 35.393, "lines": ["ליועצים ופקחים חיצוניים."], "emp": false}, {"start": 35.653, "end": 39.653, "lines": ["בתברואה מקצצים קצת יותר", "מ 400,000 שקל בשכר מול"], "emp": false}, {"start": 39.813, "end": 43.147, "lines": ["זינוק של 2.4 מיליון", "שקלים לתשלומי קבלנים."], "emp": false}, {"start": 43.187, "end": 43.847, "lines": ["תראו,"], "emp": false}, {"start": 43.887, "end": 47.187, "lines": ["מי שמבין אפילו קצת", "בניהול מערכות רואה"], "emp": false}, {"start": 47.227, "end": 50.067, "lines": ["בבירור שיש כאן תהליך", "שמוביל לתוצאה אחת בלבד."], "emp": false}, {"start": 50.107, "end": 50.933, "lines": ["קריסה."], "emp": true}, {"start": 50.973, "end": 53.213, "lines": ["הקבלן אולי יבוא לתקן את", "הכביש,"], "emp": false}, {"start": 53.253, "end": 56.073, "lines": ["אבל בלי אנשי מקצוע של", "העירייה שיוודאו שהוא לא"], "emp": false}, {"start": 56.113, "end": 57.453, "lines": ["עשה עבודה חלטורה."], "emp": false}, {"start": 57.813, "end": 60.613, "lines": ["התיקון יתפורר בגשם", "הראשון ואנחנו נישאר עם"], "emp": false}, {"start": 60.653, "end": 62.073, "lines": ["בורות ליד בתי הספר."], "emp": false}, {"start": 65.83, "end": 66.59, "lines": ["משה,"], "emp": false}, {"start": 66.63, "end": 68.63, "lines": ["נגה, איציק, רויטל,"], "emp": false}, {"start": 68.97, "end": 72.07, "lines": ["ברור לכולם שגם לכם לא", "הסבירו כלום והעבירו את"], "emp": false}, {"start": 72.11, "end": 74.583, "lines": ["העדכון תקציב הזה כשאתם", "בעיניים עצומות."], "emp": false}, {"start": 74.623, "end": 77.743, "lines": ["ואתם אמורים לראות כמונו", "לאן המהלך הזה מוביל."], "emp": false}, {"start": 77.783, "end": 78.803, "lines": ["לאסון."], "emp": true}, {"start": 78.843, "end": 80.223, "lines": ["פחות פיקוח,"], "emp": false}, {"start": 80.263, "end": 82.973, "lines": ["פחות ניקיון ופחות שירות", "לתושבים."], "emp": false}, {"start": 83.013, "end": 84.873, "lines": ["תתנגדו למחטף הזה,"], "emp": true}, {"start": 85.207, "end": 88.847, "lines": ["ותוכיחו במעשים למי אתם", "נאמנים, לציבור או לממלאי"], "emp": false}, {"start": 88.887, "end": 89.887, "lines": ["המקום."], "emp": false}]
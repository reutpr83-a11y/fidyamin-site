[
 {
  "start": 0.13,
  "end": 1.67,
  "text": "אז *פוליטי* אמרתם?"
 },
 {
  "start": 1.71,
  "end": 3.77,
  "text": "ביקורת על *מיליונים*\nהיא פוליטית?",
  "style": "emphasis"
 },
 {
  "start": 3.81,
  "end": 5.42,
  "text": "תגידו, אתם\n*השתגעתם?*",
  "style": "emphasis"
 },
 {
  "start": 5.46,
  "end": 8.84,
  "text": "ב *15* לאוקטובר יש לנו\nדיון בבית המשפט בעתירה"
 },
 {
  "start": 8.88,
  "end": 9.72,
  "text": "שהגשנו."
 },
 {
  "start": 9.76,
  "end": 12.86,
  "text": "המטרה שלנו היא *לעצור* מיד\nאת העברת הכספים הזאת,"
 },
 {
  "start": 12.9,
  "end": 14.72,
  "text": "עד שנבין בדיוק מה קורה\nפה."
 },
 {
  "start": 14.76,
  "end": 18.26,
  "text": "העירייה *מקצצת* מיליונים\nמאנשי המקצוע שעובדים"
 },
 {
  "start": 18.3,
  "end": 22.1,
  "text": "אצלה, *ושופכת* את הכסף\nהזה על קבלנים חיצוניים."
 },
 {
  "start": 22.14,
  "end": 24.91,
  "text": "פשוט *מיליונים,* שמי יודע\nלאן הם הולכים."
 },
 {
  "start": 24.95,
  "end": 26.75,
  "text": "רק כמה דוגמאות קטנות."
 },
 {
  "start": 27.07,
  "end": 30.83,
  "text": "בהנדסה מקצצים עכשיו *1.3*\nמיליון שקלים משכר עובדי"
 },
 {
  "start": 30.87,
  "end": 33.43,
  "text": "העירייה מול תוספת של\nכמעט *מיליון* שקלים"
 },
 {
  "start": 33.47,
  "end": 35.39,
  "text": "ליועצים ופקחים *חיצוניים.*"
 },
 {
  "start": 35.65,
  "end": 39.65,
  "text": "בתברואה מקצצים קצת יותר\nמ *400,000* שקל בשכר מול"
 },
 {
  "start": 39.81,
  "end": 43.15,
  "text": "זינוק של *2.4* מיליון\nשקלים לתשלומי קבלנים."
 },
 {
  "start": 43.19,
  "end": 47.19,
  "text": "תראו, מי שמבין אפילו\nקצת בניהול מערכות רואה"
 },
 {
  "start": 47.23,
  "end": 50.07,
  "text": "בבירור שיש כאן *תהליך*\nשמוביל לתוצאה אחת בלבד,"
 },
 {
  "start": 50.11,
  "end": 50.93,
  "text": "*קריסה.*",
  "style": "emphasis"
 },
 {
  "start": 50.97,
  "end": 53.21,
  "text": "*הקבלן* אולי יבוא לתקן את\nהכביש,"
 },
 {
  "start": 53.25,
  "end": 56.07,
  "text": "אבל בלי אנשי מקצוע של\nהעירייה שיוודאו שהוא לא"
 },
 {
  "start": 56.11,
  "end": 57.45,
  "text": "עשה עבודה *חלטורה.*"
 },
 {
  "start": 57.81,
  "end": 60.61,
  "text": "התיקון *יתפורר* בגשם\nהראשון ואנחנו נישאר עם"
 },
 {
  "start": 60.65,
  "end": 62.07,
  "text": "*בורות* ליד בתי הספר."
 },
 {
  "start": 62.23,
  "end": 65.03,
  "text": "משה, נגה, איציק, רויטל,"
 },
 {
  "start": 65.37,
  "end": 68.47,
  "text": "ברור לכולם שגם לכם לא\n*הסבירו* כלום והעבירו את"
 },
 {
  "start": 68.51,
  "end": 70.98,
  "text": "העדכון תקציב הזה כשאתם\nבעיניים *עצומות.*"
 },
 {
  "start": 71.02,
  "end": 73.98,
  "text": "ואתם אמורים לראות כמונו\nלאן המהלך הזה *מוביל.*"
 },
 {
  "start": 73.98,
  "end": 75.35,
  "text": "פחות *פיקוח,*"
 },
 {
  "start": 75.39,
  "end": 78.1,
  "text": "פחות *ניקיון* ופחות שירות\nלתושבים."
 },
 {
  "start": 78.14,
  "end": 80.0,
  "text": "*תתנגדו* למחטף הזה,",
  "style": "emphasis"
 },
 {
  "start": 80.34,
  "end": 83.69,
  "text": "ותוכיחו במעשים למי אתם\n*נאמנים,* לציבור או לממלא"
 },
 {
  "start": 83.69,
  "end": 84.73,
  "text": "המקום."
 }
]
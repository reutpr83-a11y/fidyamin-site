[{"start": 4.087, "end": 7.367, "lines": ["הרמתם יד והשארתם את", "עדכון התקציב בלי לדעת."], "emp": false}, {"start": 7.407, "end": 10.367, "lines": ["באותה ישיבה אמרתם שאנחנו", "לא יודעים על מה אנחנו"], "emp": false}, {"start": 10.407, "end": 11.227, "lines": ["מדברים."], "emp": false}, {"start": 11.267, "end": 13.867, "lines": ["עכשיו אתם מבינים שדווקא", "אתם לא ידעתם."], "emp": false}, {"start": 13.907, "end": 16.987, "lines": ["וזה לא אני אומרת את זה,", "בית המשפט אמר את זה."], "emp": false}, {"start": 17.027, "end": 20.96, "lines": ["תסתכלו על מה שעבר שם ומה", "זה אומר לילדים שלנו."], "emp": false}, {"start": 21.0, "end": 24.7, "lines": ["קיצצו 653,000 שקלים", "משישה סעיפי נוער,"], "emp": false}, {"start": 25.033, "end": 28.773, "lines": ["365,000 שקלים פחות בשכר", "של יחידת הנוער,"], "emp": false}, {"start": 29.113, "end": 31.913, "lines": ["150,000 שקל פחות בקידום", "נוער,"], "emp": false}, {"start": 32.287, "end": 35.993, "lines": ["52,000 שקלים פחות", "במדריכים צעירים."], "emp": false}, {"start": 36.033, "end": 36.653, "lines": ["תגידו,"], "emp": false}, {"start": 36.693, "end": 39.413, "lines": ["השתגעתם? מהנוער", "שהיה לנו לקחת?"], "emp": true}, {"start": 39.453, "end": 40.293, "lines": ["ועכשיו,"], "emp": false}, {"start": 40.333, "end": 43.193, "lines": ["אחרי כל מה שהילדים שלנו", "עברו בשנים האחרונות,"], "emp": false}, {"start": 43.233, "end": 46.413, "lines": ["כשהם מתמודדים עם חרדות,", "בדידות, קשיים חברתיים"], "emp": false}, {"start": 46.453, "end": 48.327, "lines": ["ונשירה גבוהה מאוד בחריש,"], "emp": false}, {"start": 48.367, "end": 51.587, "lines": ["עכשיו כשמה שצריך זה", "להוסיף אנשי מקצוע,"], "emp": false}, {"start": 51.627, "end": 53.633, "lines": ["מסגרות ומענים מכל סוג,"], "emp": false}, {"start": 53.673, "end": 55.813, "lines": ["אתם באמת רואים את", "המספרים האלה עכשיו"], "emp": true}, {"start": 55.853, "end": 57.02, "lines": ["ופשוט שותקים?"], "emp": true}, {"start": 57.06, "end": 60.88, "lines": ["אני מאמינה שלא תמשיכו", "לשתוק ותגנו על הילדים,"], "emp": false}, {"start": 60.92, "end": 62.98, "lines": ["רק עליהם, לא על שום דבר", "אחר."], "emp": false}, {"start": 63.347, "end": 66.387, "lines": ["זה בנפשנו, אל", "הילדים שלנו."], "emp": true}, {"start": 66.427, "end": 68.567, "lines": ["אי אפשר להמשיך", "לשבת על הגדר."], "emp": true}, {"start": 68.92, "end": 72.54, "lines": ["תתנגדו לזה ותצטרפו אלינו", "לדרישה לבטל את עדכון"], "emp": false}, {"start": 72.58, "end": 73.493, "lines": ["התקציב."], "emp": false}, {"start": 73.533, "end": 74.687, "lines": ["ככה."], "emp": false}, {"start": 74.727, "end": 75.727, "lines": ["פשוט."], "emp": false}]